[Unit]
Description=VFS495 physical capture -> fprintd virtual-image bridge
Documentation=https://github.com/saifulmd0/vfs495-linux
After=fprintd.service
[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/vfs495-fedora-bridge.py
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
